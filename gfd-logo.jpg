function startHero(){
  const slides=[...document.querySelectorAll(".hero-slide")];
  const kicker=document.getElementById("highlight-kicker");
  const title=document.getElementById("highlight-title");
  const subtitle=document.getElementById("highlight-subtitle");
  const metrics=document.getElementById("highlight-metrics");
  if(!slides.length) return;
  let index=0;

  function render(){
    slides.forEach((s,i)=>s.classList.toggle("active",i===index));
    const h=operationsHighlights[index % operationsHighlights.length];
    if(kicker) kicker.textContent=h.kicker;
    if(title) title.textContent=h.title;
    if(subtitle) subtitle.textContent=h.subtitle;
    if(metrics) metrics.innerHTML=h.metrics.map(m=>`<div><strong>${m[0]}</strong><span>${m[1]}</span></div>`).join("");
  }
  render();
  setInterval(()=>{index=(index+1)%slides.length;render();},9000);
}

async function loadCurrentOperations(){
  try{
    const data=await fetch("/api/current-operations").then(r=>{
      if(!r.ok) throw new Error(`Current operations HTTP ${r.status}`);
      return r.json();
    });

    const setNumber=(id,val)=>{
      const el=document.getElementById(id);
      if(el) el.textContent=Number(val||0).toLocaleString();
    };

    setNumber("active-incidents",data.active_incidents);
    setNumber("today-incidents",data.incidents_today);
    setNumber("live-today-tile",data.incidents_today);
    setNumber("ems-today",data.ems_today);
    setNumber("fire-other-today",data.fire_other_today);
    setNumber("units-committed",data.gilroy_units_committed);
    setNumber("chiefs-committed",data.chiefs_committed);
    setNumber("als-assigned",data.als_assigned);
    setNumber("bls-assigned",data.bls_assigned);

    const longest=document.getElementById("longest-active");
    if(longest){
      longest.textContent=data.active_incidents
        ? `${Number(data.longest_active_minutes||0).toLocaleString()} min`
        : "None active";
    }

    const updated=document.getElementById("operations-updated");
    if(updated){
      const stamp=new Date(data.updated_at);
      updated.textContent=stamp.toLocaleTimeString([], {hour:"numeric",minute:"2-digit"});
    }

    const note=document.getElementById("active-note");
    if(note){
      const committed=(data.gilroy_unit_ids||[]).join(", ");
      if(data.active_incidents>0){
        note.textContent=committed
          ? `Committed Gilroy units: ${committed}.`
          : "Active incidents are listed, but no Gilroy unit identifiers are currently available in the public source.";
      }else{
        note.textContent="No active public incidents are currently listed.";
      }
    }
  }catch(e){
    console.error("Current operations error",e);
    const note=document.getElementById("active-note");
    if(note) note.textContent="Current incident information is temporarily unavailable.";
  }
}

async function refreshDashboard(){
  await Promise.allSettled([
    loadWeather(),
    loadAlerts(),
    loadOperationsSnapshot(),
    loadCurrentOperations(),
    loadRecentIncidents()
  ]);
}

document.addEventListener("DOMContentLoaded", ()=>{
  setClock();
  startHero();
  refreshDashboard();

  setInterval(setClock, 30000);
  setInterval(loadCurrentOperations, 60000);
  setInterval(loadRecentIncidents, 60000);
  setInterval(()=>{ loadWeather(); loadAlerts(); }, 300000);
});
