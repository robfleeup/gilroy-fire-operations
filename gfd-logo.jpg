function setClock(){
  const now=new Date();
  const clock=document.getElementById("clock");
  const date=document.getElementById("date");
  if(clock) clock.textContent=now.toLocaleTimeString([], {hour:"numeric",minute:"2-digit"});
  if(date) date.textContent=now.toLocaleDateString([], {weekday:"long",month:"long",day:"numeric",year:"numeric"});
}

async function loadWeather(){
  try{
    const w=await fetch("/api/weather").then(r=>r.json());
    if(w.error) throw new Error(w.error);
    const temp=(w.temperature_f ?? "--")+"°";
    ["temperature","temperatureLarge"].forEach(id=>{const e=document.getElementById(id);if(e)e.textContent=temp;});
    const wt=document.getElementById("weatherText"); if(wt) wt.textContent=w.description||"Current";
    const wd=document.getElementById("weatherDescription"); if(wd) wd.textContent=w.description||"Current conditions";
    const wind=document.getElementById("wind"); if(wind) wind.textContent=w.wind_mph==null?"--":`${w.wind_mph} mph`;
    const hum=document.getElementById("humidity"); if(hum) hum.textContent=w.humidity==null?"--":`${w.humidity}%`;
    const gust=document.getElementById("gust"); if(gust) gust.textContent=w.gust_mph==null?"None":`${w.gust_mph} mph`;
  }catch(e){}
}

async function loadAlerts(){
  const box=document.getElementById("alertContent");
  if(!box) return;
  try{
    const data=await fetch("/api/alerts").then(r=>r.json());
    if(!data.alerts||!data.alerts.length){
      box.innerHTML='<div class="clear-mark">✓</div><h2>No active NWS alerts</h2><p>Continue to monitor official sources as conditions change.</p>';
    }else{
      box.innerHTML=data.alerts.slice(0,3).map(a=>`<div class="alert-item"><b>${a.event||"Weather Alert"}</b><span>${a.headline||""}</span></div>`).join("");
    }
  }catch(e){}
}

async function loadRecentIncidents(){
  const target=document.getElementById("recent-live-incidents");
  if(!target) return;
  try{
    const rows=await fetch("/api/recent").then(r=>r.json());
    target.innerHTML=rows.slice(0,12).map(r=>{
      const dt=new Date(r.received_at);
      const units=r.units||"No listed Gilroy unit";
      return `<div class="recent-row">
        <div><b>${r.incident_type||"Incident"}</b><span>${r.category||""}</span></div>
        <div>${r.address||"Location unavailable"}</div>
        <div>${units}</div>
        <div>${dt.toLocaleString([], {month:"short",day:"numeric",hour:"numeric",minute:"2-digit"})}</div>
        <div class="status ${r.is_active?"active":""}">${r.is_active?"Active":"Closed"}</div>
      </div>`;
    }).join("");
  }catch(e){
    target.innerHTML="<p>Incident data temporarily unavailable.</p>";
  }
}
loadRecentIncidents();
setInterval(loadRecentIncidents,60000);

function prettyUnit(unit){
  const labels={
    E47:"Engine 47",E48:"Engine 48",E49:"Engine 49",E50:"Engine 50",
    RM49:"Rescue Medic 49",E650:"Engine 650",T47:"Truck 47",
    B47:"Chief B47",B48:"Chief B48",B49:"Chief B49",B50:"Chief B50"
  };
  return labels[unit]||unit;
}
function escapeHtml(value){
  return String(value??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
}
function renderMonthlyLine(rows){
  const target=document.getElementById("monthly-line-chart");
  if(!target||!rows.length) return;
  const width=760,height=290,padL=48,padR=24,padT=24,padB=44;
  const values=rows.map(r=>Number(r.count||0));
  const max=Math.max(...values,1);
  const min=Math.min(...values,0);
  const x=(i)=>padL+i*(width-padL-padR)/Math.max(rows.length-1,1);
  const y=(v)=>padT+(max-v)*(height-padT-padB)/Math.max(max-min,1);
  const points=rows.map((r,i)=>`${x(i)},${y(Number(r.count))}`).join(" ");
  const area=`${padL},${height-padB} ${points} ${x(rows.length-1)},${height-padB}`;
  const monthLabel=(m)=>new Date(`${m}-01T12:00:00`).toLocaleDateString([], {month:"short"});
  const grid=[0.25,0.5,0.75,1].map(f=>{
    const gy=padT+(height-padT-padB)*(1-f);
    const val=Math.round(max*f);
    return `<line x1="${padL}" y1="${gy}" x2="${width-padR}" y2="${gy}" class="grid-line"/>
            <text x="${padL-10}" y="${gy+4}" text-anchor="end" class="axis-text">${val}</text>`;
  }).join("");
  const labels=rows.map((r,i)=>`
      <text x="${x(i)}" y="${height-16}" text-anchor="middle" class="axis-text">${monthLabel(r.month)}</text>
      <circle cx="${x(i)}" cy="${y(Number(r.count))}" r="5" class="line-dot"/>
      <text x="${x(i)}" y="${y(Number(r.count))-12}" text-anchor="middle" class="value-text">${Number(r.count).toLocaleString()}</text>
  `).join("");
  target.innerHTML=`<svg viewBox="0 0 ${width} ${height}" role="img" aria-label="Monthly incident trend">
    ${grid}
    <polygon points="${area}" class="line-area"/>
    <polyline points="${points}" class="line-path"/>
    ${labels}
  </svg>`;
}
function renderDonut(data){
  const target=document.getElementById("incident-donut");
  if(!target) return;
  const total=Number(data.total_incidents||0);
  const ems=Number(data.medical_count||0);
  const other=Math.max(total-ems,0);
  const pct=total?Math.round(ems/total*100):0;
  target.innerHTML=`
    <div class="donut" style="--pct:${pct}">
      <div class="donut-center"><strong>${pct}%</strong><span>EMS</span></div>
    </div>
    <div class="donut-legend">
      <div><i class="legend-ems"></i><span>EMS incidents</span><b>${ems.toLocaleString()}</b></div>
      <div><i class="legend-other"></i><span>All other incidents</span><b>${other.toLocaleString()}</b></div>
    </div>`;
}
function renderRanking(data){
  const target=document.getElementById("unit-ranking");
  if(!target) return;
  const order=["E48","E47","E49","RM49","E50","T47","E650","B47","B48","B49","B50"];
  const rows=order.map(unit=>({unit,value:Number((data.first_arriving[unit]||{}).ytd||0)}))
                  .filter(r=>r.value>0)
                  .sort((a,b)=>b.value-a.value);
  const max=Math.max(...rows.map(r=>r.value),1);
  target.innerHTML=rows.map((r,i)=>`
    <div class="rank-row">
      <div class="rank-num">${i+1}</div>
      <div class="rank-main">
        <div class="rank-label"><span>${escapeHtml(prettyUnit(r.unit))}</span><b>${r.value.toLocaleString()}</b></div>
        <div class="rank-track"><i style="width:${Math.max(3,r.value/max*100)}%"></i></div>
      </div>
    </div>`).join("");
}
async function loadOperationsSnapshot(){
  try{
    const d=await fetch("/api/firstdue-snapshot").then(r=>r.json());
    const set=(id,val)=>{const e=document.getElementById(id);if(e)e.textContent=val;};
    set("fd-total",Number(d.total_incidents).toLocaleString());
    set("fd-month",Number(d.incidents_month).toLocaleString());
    set("fd-today",Number(d.incidents_today).toLocaleString());
    set("fd-average",d.average_daily);
    set("fd-medical",`${d.medical_percent}%`);
    const asof=new Date(d.as_of);
    set("fd-asof",`Reporting through ${asof.toLocaleDateString([], {month:"short",day:"numeric",year:"numeric"})}`);
    set("fd-period",`Reporting through ${asof.toLocaleDateString([], {month:"long",day:"numeric",year:"numeric"})}`);
    set("fd-source","Department incident records");

    const order=["E47","E48","E49","E50","RM49","E650","T47","B47","B48","B49","B50"];
    const grid=document.getElementById("first-arriving-grid");
    if(grid){
      grid.innerHTML=order.map(unit=>{
        const v=d.first_arriving[unit]||{today:0,month:0,ytd:0};
        return `<article class="unit-card">
          <div class="unit-head"><b>${unit}</b><span>${prettyUnit(unit)}</span></div>
          <div class="unit-periods">
            <div><strong>${Number(v.today).toLocaleString()}</strong><small>Reporting day</small></div>
            <div><strong>${Number(v.month).toLocaleString()}</strong><small>Month</small></div>
            <div><strong>${Number(v.ytd).toLocaleString()}</strong><small>YTD</small></div>
          </div>
        </article>`;
      }).join("");
    }
    renderMonthlyLine(d.monthly);
    renderDonut(d);
    renderRanking(d);
  }catch(e){
    console.error("Operations snapshot error",e);
  }
}
loadOperationsSnapshot();

